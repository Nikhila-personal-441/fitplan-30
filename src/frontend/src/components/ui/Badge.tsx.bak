import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "@/lib/utils";

const badgeVariants = cva(
  "inline-flex items-center gap-1 rounded-full font-display font-semibold transition-smooth whitespace-nowrap",
  {
    variants: {
      variant: {
        default: "bg-primary text-primary-foreground",
        secondary: "bg-secondary text-secondary-foreground",
        outline: "border-2 border-primary text-primary bg-transparent",
        muted: "bg-muted text-muted-foreground",
        accent: "bg-accent text-accent-foreground",
        // Difficulty variants
        easy: "bg-primary/15 text-primary border border-primary/30",
        moderate: "bg-accent/20 text-accent-foreground border border-accent/40",
        hard: "bg-secondary/20 text-secondary-foreground border border-secondary/40",
        // Status variants
        completed: "bg-primary/15 text-primary",
        locked: "bg-muted text-muted-foreground",
        active: "bg-primary text-primary-foreground shadow-sm shadow-primary/30",
      },
      size: {
        default: "px-2.5 py-1 text-xs",
        sm: "px-2 py-0.5 text-xs",
        lg: "px-3.5 py-1.5 text-sm",
      },
    },
    defaultVariants: {
      variant: "default",
      size: "default",
    },
  }
);

export interface BadgeProps
  extends React.HTMLAttributes<HTMLSpanElement>,
    VariantProps<typeof badgeVariants> {}

function Badge({ className, variant, size, ...props }: BadgeProps) {
  return (
    <span className={cn(badgeVariants({ variant, size, className }))} {...props} />
  );
}

function DifficultyBadge({ difficulty }: { difficulty: string }) {
  const lower = difficulty.toLowerCase();
  const variant =
    lower === "easy" ? "easy" : lower === "moderate" ? "moderate" : "hard";

  return <Badge variant={variant}>{difficulty}</Badge>;
}

export { Badge, DifficultyBadge, badgeVariants };
